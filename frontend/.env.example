# Server-side API calls (Server Components). For a non-Docker `npm run dev`
# this is localhost; in Docker it's the "backend" service name.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Browser-side API calls (auth: login/register/refresh/logout/me). Must be
# reachable from the user's machine. Falls back to NEXT_PUBLIC_API_URL when
# unset, which is correct for a local `npm run dev`.
NEXT_PUBLIC_BROWSER_API_URL=http://localhost:8080/api/v1
