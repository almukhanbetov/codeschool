# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.
#
#   dev  : docker compose up -d                       (docker-compose.yml)
#   prod : docker compose -f docker-compose.prod.yml --env-file .env ...
#
# The dev compose has built-in defaults for every value below, so a dev .env
# is optional. The prod compose REQUIRES the ones marked "required" and will
# refuse to start without them.

# =============================================================================
# DEVELOPMENT (docker-compose.yml)
# =============================================================================

APP_ENV=development

POSTGRES_DB=codeschool
POSTGRES_USER=codeschool
POSTGRES_PASSWORD=codeschool

# Host-mapped Postgres port is 5433 (see docker-compose.yml) to avoid clashing
# with a Postgres already running on the host. Containers talk on 5432.
DATABASE_URL=postgres://codeschool:codeschool@postgres:5432/codeschool?sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT_SECRET signs the HS256 access tokens (required — the backend fails fast
# at startup if unset). Refresh tokens are random opaque strings stored
# SHA-256-hashed in an HttpOnly cookie — they are NOT JWTs, so there is no
# separate refresh secret. TTLs are Go durations (15m, 24h, 720h).
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# PUBLIC_BASE_URL — absolute base URL of the public site, used to build
# certificate verification links (…/certificates/verify/<code>). Falls back to
# the first CORS origin when unset.
PUBLIC_BASE_URL=http://localhost:3000

# Server-side API calls happen inside the frontend container -> Docker network
# address ("backend"), never "localhost".
NEXT_PUBLIC_API_URL=http://backend:8080/api/v1

# Browser-side calls (auth, and any client component fetch) -> must be
# reachable from the user's machine.
NEXT_PUBLIC_BROWSER_API_URL=http://localhost:8080/api/v1

# Base URL of the sandboxed code runner. Unset -> code-runner endpoints 503.
RUNNER_URL=http://runner:8090

# =============================================================================
# PRODUCTION (docker-compose.prod.yml)  —  conceptually a separate file/secret
# store per environment. Values below are ILLUSTRATIVE placeholders.
# =============================================================================

# APP_ENV is forced to `production` by docker-compose.prod.yml (enables gin
# ReleaseMode + Secure refresh cookie) — do not rely on this variable in prod.

# --- Postgres (required) — internal only, never published on a host port ---
# POSTGRES_DB=codeschool
# POSTGRES_USER=codeschool
# POSTGRES_PASSWORD=<generate a long random value — do NOT reuse the dev one>

# --- DATABASE_URL (required) — service name `postgres`, sslmode=disable is OK
#     because the connection never leaves the internal Docker network ---
# DATABASE_URL=postgres://codeschool:<password>@postgres:5432/codeschool?sslmode=disable

# --- Auth (required) — generate with e.g. `openssl rand -hex 48` ---
# JWT_SECRET=<long random secret, different from dev>
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h

# --- Public URLs (required) — real https:// domain behind Nginx ---
# CORS_ALLOWED_ORIGINS=https://codeschool.example.com
# PUBLIC_BASE_URL=https://codeschool.example.com
# NEXT_PUBLIC_BROWSER_API_URL=https://codeschool.example.com/api/v1

# --- Build-time frontend arg (optional) — internal server-to-server base URL ---
# NEXT_PUBLIC_API_URL=http://backend:8080/api/v1

# --- Code runner (optional) — internal service address ---
# RUNNER_URL=http://runner:8090

# --- Local production-test host ports (optional) — override to avoid clashing
#     with a running dev stack; not used once deployed behind Nginx ---
# FRONTEND_PORT=3000
# BACKEND_PORT=8080

# --- Registry images (optional) — the GHCR pipeline
#     (.github/workflows/docker-images.yml) publishes these on push to main.
#     Set them on the VPS to `docker compose pull` instead of building. ---
# BACKEND_IMAGE=ghcr.io/almukhanbetov/codeschool-backend:latest
# FRONTEND_IMAGE=ghcr.io/almukhanbetov/codeschool-frontend:latest
# RUNNER_IMAGE=ghcr.io/almukhanbetov/codeschool-runner:latest
