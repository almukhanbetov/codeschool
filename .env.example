# Used by docker-compose.yml. Copy to .env to override the defaults.

APP_ENV=development

POSTGRES_DB=codeschool
POSTGRES_USER=codeschool
POSTGRES_PASSWORD=codeschool

# Host-mapped Postgres port is 5433 (see docker-compose.yml) to avoid
# clashing with a Postgres already running on the host on 5432.
DATABASE_URL=postgres://codeschool:codeschool@postgres:5432/codeschool?sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth / JWT ---
# JWT_SECRET signs access tokens — change it for any real deployment and keep
# real secrets out of git. Access tokens are short-lived; refresh tokens live
# in an HttpOnly cookie for ~30 days.
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# All *server-side* API calls happen inside the frontend container, so this
# must be the Docker network address ("backend", the service name) — NOT
# "localhost", which inside a container refers to the container itself.
NEXT_PUBLIC_API_URL=http://backend:8080/api/v1

# Auth calls (login/register/refresh/logout/me) run in the *browser* so the
# HttpOnly refresh cookie works — this URL must be reachable from the user's
# machine, not the Docker network.
NEXT_PUBLIC_BROWSER_API_URL=http://localhost:8080/api/v1
