APP_ENV=development
PORT=8080
DATABASE_URL=postgres://codeschool:codeschool@localhost:5432/codeschool?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth / JWT. JWT_SECRET is required — the process fails fast at startup if it
# is missing. Use a long random value in any real deployment; never commit a
# real secret. TTLs are Go durations (e.g. 15m, 24h, 720h).
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
